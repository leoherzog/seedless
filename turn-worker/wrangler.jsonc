{
  "name": "seedless-turn-mint",
  "main": "src/index.js",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "turn.tournament.thehopegang.com", "custom_domain": true }
  ],
  "vars": {
    // Comma-separated list of origins allowed to fetch credentials.
    "ALLOWED_ORIGINS": "https://tournament.thehopegang.com,http://localhost:8000",
    // Cloudflare Realtime TURN key ID (dash > Realtime > TURN). Not a secret; the API token is,
    // set with: npx wrangler secret put TURN_KEY_API_TOKEN
    "TURN_KEY_ID": "63c2ea6b66c02715cc5856554a07caea",
    // Credential lifetime in seconds. Relays drop shortly after expiry, so 6 hours covers a tournament night.
    "TURN_TTL_SECONDS": "21600"
  }
}
